{
  "appId": "com.swsoftworks.pathos",
  "appName": "PathOS",
  "webDir": "../dist",
  "server": {
    "hostname": "localhost",
    "iosScheme": "capacitor"
  },
  "ios": {
    "contentInset": "automatic",
    "scrollEnabled": true,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "CapacitorHttp": { "enabled": false },
    "CapacitorCookies": { "enabled": false }
  }
}
